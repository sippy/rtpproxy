# AFL/libFuzzer dictionary for the rtpproxy configuration file fuzzer.
# UCL syntax tokens plus the rtpproxy module-configuration keys.
#
# UCL structural tokens
brace_open="{"
brace_close="}"
bracket_open="["
bracket_close="]"
equals="="
colon=":"
comma=","
dquote="\""
squote="'"
comment_cpp="//"
comment_c_open="/*"
comment_c_close="*/"
comment_hash="#"
backslash_esc="\\u0001"
macro_include=".include"
macro_path=".path"
macro_priority=".priority"
# UCL value tokens
true="true"
false="false"
null="null"
int_dec="42"
int_neg="-20"
int_hex="0x1f"
int_exp="1e10"
float_pi="3.14159"
big_num="12345678901234567890"
# rtpproxy config keys and module names
modules="modules"
load="load"
mod_acct_csv="acct_csv"
mod_acct_rtcp_hep="acct_rtcp_hep"
mod_catch_dtmf="catch_dtmf"
mod_dtls_gw="dtls_gw"
mod_ice_lite="ice_lite"
capt_host="capt_host"
capt_port="capt_port"
capt_ptype="capt_ptype"
capt_id="capt_id"
proto_udp="udp"
proto_tcp="tcp"
localhost="127.0.0.1"
port_9060="9060"
id_101="101"
dso_hep="./rtpp_acct_rtcp_hep.so"
dso_csv="./rtpp_acct_csv.so"
dso_hep_libs=".libs/rtpp_acct_rtcp_hep.so"
placeholder_topdir="@TOP_BUILDDIR@"
placeholder_hepport="@HEP_PORT@"
placeholder_hepproto="@HEP_PROTO@"
