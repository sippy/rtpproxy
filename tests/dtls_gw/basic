#!/bin/sh

# Managed control sockets and per-worker artifacts allow parallel glitching.
BASEDIR="${BASEDIR:-$(dirname -- $0)/..}"
BASEDIR="$(readlink -f -- $BASEDIR)"
. "${BASEDIR}/functions"

${MAKEANN} "${BASEDIR}/ringback.sln" "${BUILDDIR}/dtls_gw.prompt"
report "makeann DTLS prompt"

rm -f dtls_gw.?.rlog
{ ${RPTL_INT} -s "${BASEDIR}/dtls_gw/basic.rptl" \
 -D RTPPROXY_BIN="`strip_wrapper "${RTPPROXY}"`" \
 -D DSO="${TOP_BUILDDIR}/modules/dtls_gw/.libs/rtpp_dtls_gw_debug.so" \
 -D RECORD_DIR="${RECORD_DIR}" -D RECORD_SPL_DIR="${RECORD_SPL_DIR}" \
 -D SCENARIO="${RPTL_DIR}/examples/dtls.scenario.rptl" \
 -D PROMPT_NAME="${BUILDDIR}/dtls_gw.prompt" -D PYINT="${PYINT}" \
 2>&1 > dtls_gw.vars
  echo ${?} > dtls_gw.rptl.rc
} | tee dtls_gw.rlog
RPTL_RC=`cat dtls_gw.rptl.rc`

# Preserve the combined module/proxy log for glitch leak and crash checks.
for logfile in dtls_gw.?.rlog
do
  if [ -e "${logfile}" ]
  then
    cat "${logfile}" >> dtls_gw.rlog
  fi
done
report_rc ${RPTL_RC} "running DTLS gateway RPTL script"
