#!/bin/sh

# Tests session recording in various modes (R, Rs, Cs, C, Cp, N, Na). Each
# sub-test is an RPTL script recording/basic.<subtest>.rptl, which starts
# its own rtpproxy instance, sets up the session, replays pre-recorded
# traffic into the ports allocated by the rtpproxy and verifies results,
# so no pre-determined ports are needed.

BASEDIR="${BASEDIR:-$(dirname -- $0)/..}"
BASEDIR="$(readlink -f -- $BASEDIR)"

. $(dirname $0)/../functions

CD_DIR="${BASEDIR}/recording"

run_recording() {
  stest="${1}"
  ONAME="recording.${stest}.vars"
  LNAME="recording.${stest}.rlog"

  ${RPTL_INT} -s "${CD_DIR}/basic.${stest}.rptl" \
   -D SUBTEST="${stest}" \
   -D RTPPROXY_BIN="${RTPPROXY}" \
   -D RECORD_DIR="${RECORD_DIR}" \
   -D RECORD_SPL_DIR="${RECORD_SPL_DIR}" \
   -D PCAP_DIR1="${BASEDIR}/rtp_analyze" \
   -D PCAP_DIR2="${BASEDIR}/acct_rtcp_hep" \
   -D EXTRACTAUDIO="${EXTRACTAUDIO}" \
   -D PYINT="${PYINT}" \
   -D UDP_SINK="${PYTHON_DIR}/tools/udp_sink.py" \
   > "${ONAME}" 2> "${LNAME}"
  RPTL_RC=${?}
  if [ ${RPTL_RC} -ne 0 ]
  then
    cat "${LNAME}" >&2
  fi
  report_rc ${RPTL_RC} "running basic.${stest}.rptl RPTL script"
}

SUB_TESTS="${SUB_TESTS:-"files singlefile singlefile_c stopall files_stophalf singlefile_stophalf remote remote_p"}"

for stest in ${SUB_TESTS}
do
  run_recording ${stest} &
  T_RC=${?}
  eval ${stest}_PID=${!}
  report_rc "${T_RC}" "Starting sub-test \"${stest}\""
  eval ${stest}_RC=${T_RC}
done

for stest in ${SUB_TESTS}
do
  eval "T_PID=\${${stest}_PID}"
  wait ${T_PID}
  eval ${stest}_RC=${?}
done

cat /dev/null > recording.rlog

for proto in ${SUB_TESTS}
do
  lfile="recording.${proto}.rlog"
  if [ -e "${lfile}" ]
  then
    cat "${lfile}" >> recording.rlog
  fi
done

for stest in ${SUB_TESTS}
do
  eval "T_RC=\${${stest}_RC}"
  report_rc "${T_RC}" "Waiting for sub-test \"${stest}\" to complete"
done
