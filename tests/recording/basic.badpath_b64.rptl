# Same Call-IDs as in basic.badpath, with --record_callid_hash b64url: the
# Call-ID is put into the recording file name encoded with the URL-safe
# base64 alphabet (RFC 4648 sec. 5) without padding, so the recording (R, Rs)
# is created inside of the recording directory under the encoded name
# instead of being refused. Names that do not fit into PATH_MAX are still
# refused, and so is '/' in the from-tag, which is always used as is.

.eval: 0 -> RES_OK
.eval: E50 -> RES_E50
.eval: recording.%%SUBTEST%% -> WORK_BASE
.eval: ../%%WORK_BASE%%.rec. -> CALLID
.eval: ../%%WORK_BASE%%.recs. -> CALLID_S
.eval: %%WORK_BASE%%.tag -> CALLID_T
.eval: %%RECORD_SPL_DIR%%/%%CALLID%%=from_tag_1 -> REC_BASE
.eval: %%RECORD_SPL_DIR%%/%%CALLID_S%%=from_tag_1 -> REC_BASE_S

.eval: import sys, base64; print(base64.urlsafe_b64encode(sys.argv[1].encode()).decode().rstrip("=")) -> B64
.exec: %%PYINT%% -c '%%B64%%' '%%CALLID%%' -> CALLID_ENC
.exec: %%PYINT%% -c '%%B64%%' '%%CALLID_S%%' -> CALLID_S_ENC
.eval: %%RECORD_SPL_DIR%%/%%CALLID_ENC%%=from_tag_1 -> ENC_BASE
.eval: %%RECORD_SPL_DIR%%/%%CALLID_S_ENC%%=from_tag_1 -> ENC_BASE_S

# Unknown methods are rejected at startup.
.exec: %%RTPPROXY_BIN%% --record_callid_hash foo -V 2>&1 | grep -q 'unknown --record_callid_hash method'
.exec: %%RTPPROXY_BIN%% --record_callid_hash raw -V > /dev/null

.exec: mkdir -p %%RECORD_SPL_DIR%%
.exec: rm -f %%REC_BASE%%.* %%REC_BASE_S%%* %%ENC_BASE%%.* %%ENC_BASE_S%%*

# Longer than PATH_MAX once encoded on any supported platform, yet short
# enough for the commands carrying it to fit into the RTPP_CMD_BUFLEN.
.exec: printf '%4200s' '' | tr ' ' x -> LONG_NAME
.eval: %%WORK_BASE%%.long.%%LONG_NAME%% -> CALLID_LONG

.eval: -d dbug -T60 -W60 -P -r %%RECORD_SPL_DIR%% --record_callid_hash b64url -> RTPPROXY_ARGS
socket rtpp: stdio: %%RTPPROXY_ARGS%% -> %%WORK_BASE%%.rout

rtpp: U %%CALLID%% 127.0.0.1 12345 from_tag_1 -> validate_port(_)
rtpp: L %%CALLID%% 127.0.0.1 54321 from_tag_1 to_tag_1 -> validate_port(_)
rtpp: R %%CALLID%% to_tag_1 from_tag_1 -> str_compare(RES_OK)

rtpp: U %%CALLID_S%% 127.0.0.1 12345 from_tag_1 -> validate_port(_)
rtpp: L %%CALLID_S%% 127.0.0.1 54321 from_tag_1 to_tag_1 -> validate_port(_)
rtpp: Rs %%CALLID_S%% to_tag_1 from_tag_1 -> str_compare(RES_OK)

rtpp: U %%CALLID_T%% 127.0.0.1 12345 ../from_tag_1 -> validate_port(_)
rtpp: L %%CALLID_T%% 127.0.0.1 54321 ../from_tag_1 to_tag_1 -> validate_port(_)
rtpp: R %%CALLID_T%% to_tag_1 ../from_tag_1 -> str_compare(RES_E50)

rtpp: U %%CALLID_LONG%% 127.0.0.1 12345 from_tag_1 -> validate_port(_)
rtpp: L %%CALLID_LONG%% 127.0.0.1 54321 from_tag_1 to_tag_1 -> validate_port(_)
rtpp: R %%CALLID_LONG%% to_tag_1 from_tag_1 -> str_compare(RES_E50)
rtpp: Rs %%CALLID_LONG%% to_tag_1 from_tag_1 -> str_compare(RES_E50)

.close: rtpp
.exec: for f in %%REC_BASE%%.* %%REC_BASE_S%%*; do test ! -e "$f" || exit 1; done
.exec: ls %%ENC_BASE%%.* %%ENC_BASE_S%%* > /dev/null
.exec: rm -f %%ENC_BASE%%.* %%ENC_BASE_S%%*
