# Common prologue of the recording/basic sub-tests: start an rtpproxy
# instance and create a session. Ports are allocated by the rtpproxy
# itself and stored in PORT_A (U) and PORT_O (L).
#
# Expects SUBTEST, RTPPROXY_BIN, RECORD_DIR and RECORD_SPL_DIR to be defined.

.eval: 0 -> RES_OK
.eval: E50 -> RES_E50
.eval: recording.%%SUBTEST%%.rec. -> CALLID
.eval: %%RECORD_DIR%%/%%CALLID%%=from_tag_1 -> REC_BASE
.eval: recording.%%SUBTEST%% -> WORK_BASE
.eval: rtpa_nsent rtpa_nrcvd rtpa_ndups rtpa_nlost rtpa_perrs -> STATS_KEYS

.exec: rm -f %%REC_BASE%%.*

.eval: -d dbug -b -T2 -W2 -P -r %%RECORD_DIR%% -S %%RECORD_SPL_DIR%% -> RTPPROXY_ARGS
socket rtpp: stdio: %%RTPPROXY_ARGS%% -> %%WORK_BASE%%.rout

rtpp: U %%CALLID%% 127.0.0.1 12345 from_tag_1 -> validate_port(PORT_A)
rtpp: L %%CALLID%% 127.0.0.1 54321 from_tag_1 to_tag_1 -> validate_port(PORT_O)
