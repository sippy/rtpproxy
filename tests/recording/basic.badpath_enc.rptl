# Same Call-IDs as in basic.badpath, with --record_fname_encode: '/' and
# '%' in the Call-ID or from-tag are written as "%2F" and "%25", so the
# recording (R, Rs) is created inside of the recording directory under the
# encoded name instead of being refused. Names that do not fit into
# PATH_MAX are still refused.

.eval: 0 -> RES_OK
.eval: E50 -> RES_E50
.eval: recording.%%SUBTEST%% -> WORK_BASE
.eval: ../%%WORK_BASE%%.rec. -> CALLID
.eval: ../%%WORK_BASE%%.recs. -> CALLID_S
.eval: %%WORK_BASE%%.pct%41 -> CALLID_P
.eval: %%RECORD_SPL_DIR%%/%%CALLID%%=from_tag_1 -> REC_BASE
.eval: %%RECORD_SPL_DIR%%/%%CALLID_S%%=from_tag_1 -> REC_BASE_S
# Same names, encoded ('?' stands for the '%' of the escape sequences).
.eval: %%RECORD_SPL_DIR%%/..?2F%%WORK_BASE%%.rec.=from_tag_1 -> ENC_BASE
.eval: %%RECORD_SPL_DIR%%/..?2F%%WORK_BASE%%.recs.=from_tag_1 -> ENC_BASE_S
.eval: %%RECORD_SPL_DIR%%/%%WORK_BASE%%.pct?2541=from_tag_1 -> ENC_BASE_P

.exec: mkdir -p %%RECORD_SPL_DIR%%
.exec: rm -f %%REC_BASE%%.* %%REC_BASE_S%%* %%ENC_BASE%%.* %%ENC_BASE_S%%* %%ENC_BASE_P%%.*

# Longer than PATH_MAX on any supported platform, yet short enough for
# the commands carrying it to fit into the RTPP_CMD_BUFLEN.
.exec: printf '%4200s' '' | tr ' ' x -> LONG_NAME
.eval: %%WORK_BASE%%.long.%%LONG_NAME%% -> CALLID_LONG

.eval: -d dbug -T60 -W60 -P -r %%RECORD_SPL_DIR%% --record_fname_encode -> RTPPROXY_ARGS
socket rtpp: stdio: %%RTPPROXY_ARGS%% -> %%WORK_BASE%%.rout

rtpp: U %%CALLID%% 127.0.0.1 12345 from_tag_1 -> validate_port(_)
rtpp: L %%CALLID%% 127.0.0.1 54321 from_tag_1 to_tag_1 -> validate_port(_)
rtpp: R %%CALLID%% to_tag_1 from_tag_1 -> str_compare(RES_OK)

rtpp: U %%CALLID_S%% 127.0.0.1 12345 from_tag_1 -> validate_port(_)
rtpp: L %%CALLID_S%% 127.0.0.1 54321 from_tag_1 to_tag_1 -> validate_port(_)
rtpp: Rs %%CALLID_S%% to_tag_1 from_tag_1 -> str_compare(RES_OK)

rtpp: U %%CALLID_P%% 127.0.0.1 12345 from_tag_1 -> validate_port(_)
rtpp: L %%CALLID_P%% 127.0.0.1 54321 from_tag_1 to_tag_1 -> validate_port(_)
rtpp: R %%CALLID_P%% to_tag_1 from_tag_1 -> str_compare(RES_OK)

rtpp: U %%CALLID_LONG%% 127.0.0.1 12345 from_tag_1 -> validate_port(_)
rtpp: L %%CALLID_LONG%% 127.0.0.1 54321 from_tag_1 to_tag_1 -> validate_port(_)
rtpp: R %%CALLID_LONG%% to_tag_1 from_tag_1 -> str_compare(RES_E50)
rtpp: Rs %%CALLID_LONG%% to_tag_1 from_tag_1 -> str_compare(RES_E50)

.close: rtpp
.exec: for f in %%REC_BASE%%.* %%REC_BASE_S%%*; do test ! -e "$f" || exit 1; done
.exec: ls %%ENC_BASE%%.* %%ENC_BASE_S%%* %%ENC_BASE_P%%.* > /dev/null
.exec: rm -f %%ENC_BASE%%.* %%ENC_BASE_S%%* %%ENC_BASE_P%%.*
