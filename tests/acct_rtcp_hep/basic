#!/bin/sh

# Exercise HEP over TCP and UDP using dynamically allocated ports. RPTL
# manages rtpproxy, the HEP receiver and both traffic replay processes.

BASEDIR="${BASEDIR:-$(dirname -- $0)/..}"
BASEDIR="$(readlink -f -- $BASEDIR)"

. $(dirname $0)/../functions

CD_DIR="${BASEDIR}/acct_rtcp_hep"

run_acct_rtcp_hep() {
  proto="${1}"
  rec_args=""
  npkts=320
  if [ "${proto}" = udp ]
  then
    rec_args="-R"
    npkts=319
  fi
  # Keep the full diagnostic log, but show progress as each step completes.
  # Record the runner's status separately because the pipeline returns awk's.
  { ${RPTL_INT} -s "${CD_DIR}/basic.rptl" \
   -D HEP_PROTO="${proto}" -D REC_ARGS="${rec_args}" -D NPKTS="${npkts}" \
   -D RTPPROXY_BIN="`strip_wrapper "${RTPPROXY}"`" \
   -D RECORD_DIR="${RECORD_DIR}" -D RECORD_SPL_DIR="${RECORD_SPL_DIR}" \
   -D TOP_BUILDDIR="${TOP_BUILDDIR}" -D CD_DIR="${CD_DIR}" \
   -D EXTRACTAUDIO="`strip_wrapper "${EXTRACTAUDIO}"`" -D PYINT="${PYINT}" \
   2>&1 > "acct_rtcp_hep.${proto}.vars"
    echo ${?} > "acct_rtcp_hep.${proto}.rptl.rc"
  } | tee "acct_rtcp_hep.${proto}.rlog" | awk '/^OK: / { print; fflush() }'
  RPTL_RC=`cat "acct_rtcp_hep.${proto}.rptl.rc"`
  if [ ${RPTL_RC} -ne 0 ]
  then
    cat "acct_rtcp_hep.${proto}.rlog" >&2
  fi
  return ${RPTL_RC}
}

rm -f rtpproxy_acct.csv

run_acct_rtcp_hep tcp &
TTCP_RC=${?}
TTCP_PID=${!}
report_rc "${TTCP_RC}" "Starting sub-test on HEP/tcp"
run_acct_rtcp_hep udp &
TUDP_RC=${?}
TUDP_PID=${!}
report_rc "${TUDP_RC}" "Starting sub-test on HEP/udp"
wait ${TTCP_PID}
TTCP_RC=${?}
wait ${TUDP_PID}
TUDP_RC=${?}
cat acct_rtcp_hep.tcp.rlog acct_rtcp_hep.udp.rlog > acct_rtcp_hep.rlog
report_rc "${TTCP_RC}" "Waiting for HEP/tcp to complete"
report_rc "${TUDP_RC}" "Waiting for HEP/udp to complete"

nlexpected=3
anlines=$((`wc -l < rtpproxy_acct.csv`))
test ${anlines} -eq ${nlexpected}
report "checking number of lines in rtpproxy_acct.csv: ${anlines} vs ${nlexpected}"
