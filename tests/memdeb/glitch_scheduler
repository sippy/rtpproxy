#!/bin/sh

# Verify dynamic dispatch without running or faulting an rtpproxy instance.
BASEDIR="${BASEDIR:-$(dirname -- $0)/..}"
BASEDIR="$(readlink -f -- "${BASEDIR}")"
QUEUE_HELPERS="${BASEDIR}/memdeb"
. "${BASEDIR}/functions"
. "${QUEUE_HELPERS}/glitch.sub"

fixture_root="`mktemp -d "${TMPDIR:-/tmp}/glitch-scheduler.XXXXXXXX"`" || exit 1
trap 'rm -rf "${fixture_root}"' EXIT
ln -s "${QUEUE_HELPERS}" "${fixture_root}/memdeb" || exit 1
BASEDIR="${fixture_root}"
export BASEDIR
real_mktemp="${MKTEMP_CMD}"
scheduler_mktemp() {
  printf '%s\n' "${*}" >> "${fixture_root}/mktemp.calls"
  ${real_mktemp} "${@}"
}
MKTEMP_CMD=scheduler_mktemp
: > "${fixture_root}/mktemp.calls"
cat > "${fixture_root}/test" <<'EOT'
#!/bin/sh
if [ "${OMIT_LOG:-0}" != 1 ]
then
  : > test.rlog
fi
cookie="${RTPP_GLITCH_TRIG%%:*}"
printf '%s\n' "${PWD##*/}" >> "${RESULTS_ROOT}/${cookie}"
printf '%s\n' "${cookie}" >> "${RESULTS_ROOT}/order"
if [ "${SLOW_TEST}" = 1 ] && [ "${cookie}" = c0003 ]
then
  # Hold the first slot until another worker claims the last point.
  tries=0
  while [ ! -e "${RESULTS_ROOT}/c0006" ] && [ "${tries}" -lt 100 ]
  do
    sleep 0.05
    tries=$((tries + 1))
  done
fi
case "${cookie}" in
  c0001|c0004) exit 0 ;;
  *) exit 1 ;;
esac
EOT
chmod +x "${fixture_root}/test" || exit 1

for workers in 2 1 50
do
  mkdir "${fixture_root}/${workers}" || exit 1
  cd "${fixture_root}/${workers}" || exit 1
  RESULTS_ROOT="$(pwd)/results"
  mkdir "${RESULTS_ROOT}" || exit 1
  SLOW_TEST=0
  [ "${workers}" = 2 ] && SLOW_TEST=1
  export RESULTS_ROOT SLOW_TEST
  cat > glitch1.ncout <<'EOT'
s1: c0003 called from setup() at z.c:90
s2: c0001 called from setup() at a.c:10
s3: c0003 called from setup() at z.c:90
s4: c0002 called from setup() at m.c:20
s5: c0004 called from setup() at b.c:40
s6: c0001 called from setup() at a.c:10
s7: c0005 called from setup() at c.c:50
s8: c0006 called from setup() at c.c:60
EOT
  before="`wc -l < "${fixture_root}/mktemp.calls"`"
  glitch_do test 2 test.rlog "${workers}" > run.log 2>&1
  rc=${?}
  cat run.log
  report_rc "${rc}" "scheduler with ${workers} workers"
  after="`wc -l < "${fixture_root}/mktemp.calls"`"
  expected_calls=1
  [ "${workers}" -gt 1 ] && expected_calls=$((workers + 1))
  [ "$((after - before))" -eq "${expected_calls}" ] || exit 1
  report_rc 0 "creating worker directories through the credential wrapper"
  grep -q '^2 times ineffective, 4 times effective$' run.log
  report "aggregating worker results"
  for cookie in c0003 c0001 c0002 c0004 c0005 c0006
  do
    [ "`wc -l < "${RESULTS_ROOT}/${cookie}"`" -eq 1 ] || exit 1
  done
  if [ "${workers}" = 2 ]
  then
    slow_worker="`cat "${RESULTS_ROOT}/c0003"`"
    fast_worker="`cat "${RESULTS_ROOT}/c0001"`"
    [ "${slow_worker}" != "${fast_worker}" ] || exit 1
    for cookie in c0002 c0004 c0005 c0006
    do
      [ "`cat "${RESULTS_ROOT}/${cookie}"`" = "${fast_worker}" ] || exit 1
    done
    report_rc 0 "idle worker drains the queue while the first worker is busy"
  elif [ "${workers}" = 1 ]
  then
    printf '%s\n' c0003 c0001 c0002 c0004 c0005 c0006 > expected
    diff -u expected "${RESULTS_ROOT}/order"
    report "preserving first-seen order without duplicate execution"
  fi
done

# Do not reuse a previous iteration's log or count setup failures as faults.
OMIT_LOG=1
export OMIT_LOG
printf '%s\n' 'stale log' > test.rlog
glitch_do test 2 test.rlog 1 > missing.log 2>&1
reportifnotfail "rejecting a missing per-test log"
grep -q 'missing or unreadable test log' missing.log
report "reporting the missing log without grep errors"
test ! -e test.rlog
report "removing stale per-test logs"
failure_workdir="`awk '/^Glitching failed; worker logs retained in / {print $NF}' missing.log`"
[ -n "${failure_workdir}" ] || exit 1
rm -rf "${failure_workdir}"
