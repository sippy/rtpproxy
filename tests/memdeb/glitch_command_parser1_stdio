#!/bin/sh

TDIR="`dirname "${0}"`"
BASEDIR="${TDIR}/.."
SUDO_REQUIRED=0
. "${BASEDIR}/functions"

. "${TDIR}/glitch.sub"

disable_aslr "${@}"

export RTPP_TEST_SOCKETS="stdio:"
# Optional first argument selects the number of concurrent glitching jobs.
glitch_test "command_parser/command_parser1" 46 command_parser.rlog "" 0 "${1:-50}"
report "glitching command_parser/command_parser1"
