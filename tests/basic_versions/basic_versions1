#!/bin/sh

# Exercise the same control protocol info commands over every supported
# transport. RPTL owns the listeners and allocates their ports atomically.
BASEDIR="`dirname "${0}"`/.."
. "${BASEDIR}/functions"

BV_LOGFILE=basic_versions.rlog
truncate -s 0 "${BV_LOGFILE}"

# Keep the command list and reference output shared with the original test.
awk '{print "rtpp: " $0}' "${BASEDIR}/basic_versions/basic_versions.input" \
  > basic_versions.commands.rptl
report "preparing basic_versions commands"
sed '/^MEMDEB(rtpproxy): all clear$/d' \
  "${BASEDIR}/basic_versions/basic_versions.output" > basic_versions.model
report "preparing basic_versions reference output"

for transport in stdio udp unix tcp cunix udp6 tcp6
do
  out="basic_versions.${transport}"
  ${RPTL_INT} -s "${BASEDIR}/basic_versions/basic_versions.rptl" \
    -D RTPPROXY_BIN="`strip_wrapper "${RTPPROXY}"`" \
    -D CONTROL="${transport}:" -D OUT="${out}" \
    -D COMMANDS="$(pwd)/basic_versions.commands.rptl" \
    -D CMD_TIMEOUT=10 > "${out}.vars" 2> "${out}.rptl.rlog"
  rc=${?}
  cat "${out}.rlog" "${out}.rptl.rlog" >> "${BV_LOGFILE}"
  if [ "${rc}" -ne 0 ]
  then
    cat "${out}.rlog" "${out}.rptl.rlog" >&2
  fi
  report_rc "${rc}" "running basic_versions on ${transport}"
  ${DIFF} basic_versions.model "${out}.qout"
  report "basic_versions replies on ${transport}"
  grep -Fq 'MEMDEB(rtpproxy): all clear' "${out}.rlog"
  report "basic_versions memory cleanup on ${transport}"
done
