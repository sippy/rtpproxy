#!/bin/sh

# Tests forwarding of payloads from one end-point to another, and the
# reverse of that scenario. This also tests "record session to a file"
# functionality and subsequent decoding of the audio using extractaudio.
#
# The setup is as follows. We setup 3 rtpproxy instances:
#
# +-----+      +-----+      +-----+
# |Gen.O|<---->| Fwd |<---->|Gen.A|
# +-----+      +-----+      +-----+
#
# Uni-directional RTP streams are generated by the Gen.O and Gen.A
# instances simultaneously and they are delivered to the Fwd instance.
# Each of the Gen.O and Gen.A instances also records incoming streams into
# disk files, Gen.O in the AdHoc format and Gen.A in the PCAP format. All
# streams are then decoded and checksum is compared to the reference value.
# 
# We also setup several streams (for all supported codecs) and enable
# re-packetization from 10ms for most codecs (20ms for GSM) to 40ms in one
# direction and 60ms in the other.
#
# The commands are issued by forwarding1.rptl, with all ports allocated
# dynamically, for each set of codecs in turn.

BASEDIR="`dirname "${0}"`/.."
. "${BASEDIR}/functions"

CODEC_SETS="${CODEC_SETS:-"0,3,4,8,9 18,3,4,9,0"}"
OUT="forwarding1"

# The tools may be run under a wrapper, e.g. setpriv when started as root.
# The RPTL interpreter is wrapped as well, so whatever it starts already
# runs with the right credentials: give it bare commands.
strip_wrapper() {
  echo "${1##* -- }"
}

rotate_CODECSA() {
  first_codec="${1}"
  shift
  CODECSA="${@} ${first_codec}"
}

# Pair every codec with every other one, in both directions, plus one more
# round with the re-packetization enabled
setup_codecs() {
  CODECSO="${1}"
  CODECSA="${1}"
  _CODECSO=""
  _CODECSA=""
  i=0
  while [ ${i} -eq 0 -o "${CODECSO}" != "${CODECSA}" ]
  do
    i=1
    _CODECSO="${_CODECSO} ${CODECSO}"
    _CODECSA="${_CODECSA} ${CODECSA}"
    rotate_CODECSA ${CODECSA}
  done
  REPACK_CODECSO="${CODECSO}"
  rotate_CODECSA ${CODECSA}
  REPACK_CODECSA="${CODECSA}"
  CODECSO="${_CODECSO}"
  CODECSA="${_CODECSA}"
}

# K:CODEC_O:CODEC_A:KIND for each call, K starting from 1
setup_calls() {
  CALLS=""
  k=1
  set -- ${CODECSA} ${REPACK_CODECSA}
  for co in ${CODECSO} ${REPACK_CODECSO}
  do
    if [ ${k} -le `echo ${CODECSO} | wc -w` ]
    then
      kind=n
    else
      kind=r
    fi
    CALLS="${CALLS} ${k}:${co}:${1}:${kind}"
    shift
    k=$((${k} + 1))
  done
  NCALLS=$((${k} - 1))
  COPIES=""
  DELETES=""
  k=${NCALLS}
  while [ ${k} -gt 0 ]
  do
    COPIES="${COPIES} ${k}"
    if [ ${k} -gt $(((${NCALLS} + 1) / 2)) ]
    then
      DELETES="${DELETES} ${k}"
    fi
    k=$((${k} - 1))
  done
}

cumnlost=0
MAX_CUMNLOST=30

verify_results()
{
  direction="${1}"
  shift
  i=1
  for codec in ${1} ${2}
  do
    rm -f forwarding1.${codec}.wav
    ${EXTRACTAUDIO} -n -s forwarding1_${direction}_${i}=from_tag_1 forwarding1.${codec}.wav | \
      grep -v 'delta ' | tee forwarding1.${codec}.eout
    report "extractaudio forwarding1_${direction}_${i} forwarding1.${codec}.wav"
    nlost=`grep plost= forwarding1.${codec}.eout | sed 's|.* plost=||'`
    if [ ${nlost} -eq 0 ]
    then
      sha256_verify forwarding1.${codec}.wav forwarding/forwarding1.checksums
    else
      cumnlost=$((${cumnlost} + ${nlost}))
      if [ ${cumnlost} -lt ${MAX_CUMNLOST} ]
      then
        ok "Some packet loss detected, skipping checksum validation for the forwarding1.${codec}.wav"
      else
        fail "Cumulative packet loss is too high ${cumnlost} current, ${MAX_CUMNLOST} max"
      fi
    fi
    i=$((${i}+1))
  done
}

# Ports are allocated dynamically and checked by forwarding1.rptl, so
# replace them before comparing the replies with the reference ones.
normalize() {
  awk '/^[0-9]+$/ && $1 >= 1024 { print "PORT"; next } { print }' "${1}"
}

verify_reslogs()
{
  local restype="${1}"
  normalize ${OUT}${restype}.rout > ${OUT}${restype}.rout.norm
  if ! ${REVTEMPL} forwarding/forwarding1${restype}.moutput ${OUT}${restype}.rout.norm \
    forwarding/forwarding1${restype}.output > ${OUT}${restype}.rout.amod
  then
    ${DIFF} forwarding/forwarding1${restype}.output ${OUT}${restype}.rout.norm
    local DIFF_RC=${?}
  else
    ${DIFF} forwarding/forwarding1${restype}.output ${OUT}${restype}.rout.amod
    local DIFF_RC=${?}
  fi
  return ${DIFF_RC}
}

run_set() {
  TEST_CODECS="`echo "${1}" | tr ',' ' '`"
  setup_codecs "${TEST_CODECS}"
  setup_calls

  rm -f rtpproxy_acct.csv
  witness_start forwarding1 "${OUT}.rout ${OUT}.geno.rout ${OUT}.gena.rout ${OUT}.rlog ${OUT}.geno.rlog ${OUT}.gena.rlog ${OUT}.rptl.rlog"
  ${RPTL_INT} -s "${BASEDIR}/forwarding/forwarding1.rptl" \
   -D RTPPROXY_BIN="`strip_wrapper "${RTPPROXY}"`" \
   -D RECORD_DIR="${RECORD_DIR}" -D RECORD_SPL_DIR="${RECORD_SPL_DIR}" \
   -D CONF="forwarding/rtpproxy.conf" -D CTRL_SOCK="/tmp/forwarding1.$$.sock" \
   -D CALLS="${CALLS}" -D COPIES="${COPIES}" -D DELETES="${DELETES}" \
   -D TRASH="${TRASH_PORT1}" -D PYINT="${PYINT}" -D OUT="${OUT}" \
   > ${OUT}.vars 2> ${OUT}.rptl.rlog
  RPTL_RC=${?}
  if [ ${RPTL_RC} -ne 0 ]
  then
    cat ${OUT}.rptl.rlog >&2
  fi
  report_rc ${RPTL_RC} "running forwarding1.rptl, codecs ${TEST_CODECS}"

  verify_reslogs ""
  report "checking rtpproxy.fwd replies, codecs ${TEST_CODECS}"
  verify_reslogs ".geno"
  report "checking rtpproxy.geno replies, codecs ${TEST_CODECS}"
  verify_reslogs ".gena"
  report "checking rtpproxy.gena replies, codecs ${TEST_CODECS}"

  verify_results "o" "${CODECSA}" "${REPACK_CODECSA}"
  verify_results "a" "${CODECSO}" "${REPACK_CODECSO}"

  witness_stop

  test -e rtpproxy_acct.csv
  report "checking if rtpproxy_acct.csv is present"
  nlexpected="181"
  anlines=$((`wc -l < rtpproxy_acct.csv`))
  test ${anlines} -eq ${nlexpected}
  report "checking number of lines in rtpproxy_acct.csv: ${anlines} vs ${nlexpected}"
}

for codec in 0 3 4 8 9 18
do
  rm -f ${BASEDIR}/forwarding1.${codec}
done
${MAKEANN} ${BASEDIR}/ringback.sln ${BASEDIR}/forwarding1
report "makeann forwarding1"
# makeann has no G.723 encoder
case ",`echo ${CODEC_SETS} | tr ' ' ','`," in
*,4,*)
  ffmpeg -loglevel error -i ${BASEDIR}/ringback.sln -f g723_1 -b:a 6300 ${BASEDIR}/forwarding1.4
  report "ffmpeg forwarding1.4"
  ;;
esac

# Best effort, raising the limits needs privileges
setup_buffers 2>/dev/null

for cset in ${CODEC_SETS}
do
  run_set "${cset}"
done
