# Test that session timeouts for fully setup sessions and half-setup sessions
# work correctly and there is no early/late destruction of sessions, for each
# type of the control socket. See basic.rptl for details.

. "${BASEDIR}/functions"

# Control socket types, in the order of the RTPP<j> IDs in tnotify.output
CTYPES="stdio: udp: unix: tcp: cunix: udp6: tcp6:"

# Output files are named after the test, so the tests can run in parallel
OUT="session_timeouts.`basename "${0}"`"

# The tools may be run under a wrapper, e.g. setpriv when started as root.
# The RPTL interpreter is wrapped as well, so whatever it starts already
# runs with the right credentials: give it bare commands.
strip_wrapper() {
  echo "${1##* -- }"
}

# Ports are allocated dynamically, so replace each one by its order of
# appearance before comparing the replies.
normalize() {
  grep -v '^MEMDEB(' "${1}" | awk '
    $1 ~ /^[0-9]+$/ && $1 >= 1024 {
      if (!($1 in ports))
        ports[$1] = "P" nports++
      $1 = ports[$1]
    }
    { print }'
}

__beforeexit_cleanup()
{
  if [ ! -z "${RTPP_NC_PID}" ]
  then
    kill "${RTPP_NC_PID}"
  fi
}

run_test()
{
  notify_sock="${1}"
  if [ "${notify_sock}" = "${RTPP_NOTIFY_SOCK_WILD}" ]
  then
    client_notify_sock="${RTPP_NOTIFY_SOCK_WILD_BIND}"
  else
    client_notify_sock="${notify_sock}"
  fi
  case "${client_notify_sock}" in
  tcp:*)
    client_notify_sock1="${client_notify_sock}:0"
    ;;
  *)
    client_notify_sock1="${client_notify_sock}"
    ;;
  esac
  set -- `${RTPP_NOTYFY_CLIENT} -D -s "${client_notify_sock1}" -o "${OUT}.tlog" \
   -t 120 -l "${OUT}.tout"`
  RTPP_NC_RC=${?}
  RTPP_NC_PID="${1}"
  RTPP_NC_PORT="${2}"
  if [ -z "${RTPP_NC_PID}" ]
  then
    RTPP_NC_RC=1
  fi
  case "${client_notify_sock}" in
  tcp:*)
    if [ -z "${RTPP_NC_PORT}" ]
    then
      RTPP_NC_RC=1
    else
      client_notify_sock="${client_notify_sock}:${RTPP_NC_PORT}"
      notify_sock="${notify_sock}:${RTPP_NC_PORT}"
    fi
    ;;
  *)
    ;;
  esac
  report_rc ${RTPP_NC_RC} "Starting rtpp_notify_client.py on ${client_notify_sock}"

  setup_tstart
  j=1
  for ctype in ${CTYPES}
  do
    ${RPTL_INT} -s "${BASEDIR}/session_timeouts/basic.rptl" \
     -D CTYPE="${ctype}" -D J="${j}" -D NS="${notify_sock}" \
     -D OUT="${OUT}" \
     -D RTPPROXY_BIN="`strip_wrapper "${RTPPROXY}"`" \
     > "${OUT}.vars${j}" 2> "${OUT}.rlog${j}" &
    eval RPTL${j}_PID=${!}
    j=$((${j} + 1))
  done

  j=1
  for ctype in ${CTYPES}
  do
    eval "RPTL_PID=\${RPTL${j}_PID}"
    wait ${RPTL_PID}
    RPTL_RC=${?}
    if [ ${RPTL_RC} -ne 0 ]
    then
      cat "${OUT}.rlog${j}" >&2
    fi
    report_rc ${RPTL_RC} "running basic.rptl for ${ctype} control socket"
    for i in 1 2 3 4
    do
      case ${i} in
      1|2)
        ofile="${BASEDIR}/session_timeouts/ipv4_${i}.output"
        ;;
      *)
        ofile="${BASEDIR}/session_timeouts/ipv6_$((${i} - 2)).output"
        ;;
      esac
      normalize "${ofile}" > "${OUT}.eout${j}.${i}"
      normalize "${OUT}.rout${j}.${i}" > "${OUT}.nout${j}.${i}"
      ${DIFF} "${OUT}.eout${j}.${i}" "${OUT}.nout${j}.${i}"
      report "checking replies of rtpproxy #${j}.${i} on ${ctype} control socket"
    done
    j=$((${j} + 1))
  done

  notify_client_stop "${RTPP_NC_PID}"

  sort "${OUT}.tlog" > "${OUT}.tlog.sorted"
  sort "${BASEDIR}/session_timeouts/tnotify.output" | ${DIFF} - "${OUT}.tlog.sorted"
  report "checking rtpp_notify_client.py on ${client_notify_sock} output"
}
