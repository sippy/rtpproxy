# Query final statistics and release one setup and its recorder session.
.eval: %%ROOT_OUT%%.%%MODE%% -> OUT
.eval: rtpp_%%MODE%% -> R
.eval: %%OUT%%.sink -> SINK_CID
%%R%%: Gv npkts_rcvd npkts_played npkts_relayed npkts_discard nplrs_created nplrs_destroyed
%%R%%: Gv rtpa_nsent rtpa_nrcvd rtpa_ndups rtpa_nlost rtpa_perrs
%%R%%: Gv nsess_created nsess_destroyed nsess_timeout nsess_complete nsess_nortp nsess_owrtp nsess_nortcp nsess_owrtcp
%%R%%: Gv ncmds_rcvd ncmds_succd ncmds_errs ncmds_repld
.echo: OK: queried global stats

.close: %%R%%
.echo: OK: %%R%% has exited

sink: D %%SINK_CID%% from_tag_1 -> str_compare(RES_OK)
