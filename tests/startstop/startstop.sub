if [ -z "${STARTSTOP_CONTROL_ARGS}" ]
then
  exec ${PYINT} "${BASEDIR}/startstop/control_sockets.py" "${0}" "${@}"
fi

__beforeexit_cleanup()
{
  if [ ! -z "${TMP_PIDFILE}" ]
  then
    rtpproxy_stop TERM
  fi
  if [ -f "${TMP_LOGFILE}" -a "${TMP_LOGFILE}" != "/dev/null" ]
  then
    cat "${TMP_LOGFILE}" >> "${TS_LOGFILE}"
    rm "${TMP_LOGFILE}"
  fi
  if [ -n "${STARTSTOP_TMPDIR}" ]
  then
    rm -rf "${STARTSTOP_TMPDIR}"
  fi
}

test_startstop() {
  RTPP_OUTFILE="${1}"
  RTPPROXY="${2}"
  RTPP_CONF="${3}"
  RTPP_DSOS="${4}"
  REF_OUTFILE="${5}"

  truncate -s 0 "${TS_LOGFILE}"

  # In root CI, MKTEMP_CMD runs as the daemon user. Pre-create the config
  # too, so shell redirection retains its ownership even with umask 077.
  STARTSTOP_TMPDIR="`${MKTEMP_CMD} -d "${TMPDIR:-/tmp}/startstop.XXXXXXXX"`" || return 1
  STARTSTOP_CONF="`${MKTEMP_CMD} "${STARTSTOP_TMPDIR}/rtpproxy.conf.XXXXXXXX"`" || return 1
  # Module paths in the shared config are relative to the tests directory.
  # Workers run elsewhere, so render a private config with absolute paths.
  sed "s|../modules/|${TOP_BUILDDIR}/modules/|g" \
    "${BASEDIR}/${RTPP_CONF}" > "${STARTSTOP_CONF}" || return 1
  RTPP_CONF="${STARTSTOP_CONF}"

  myuid="`${ID_CMD} -un`"
  mygid="`${ID_CMD} -gn`"

  RTPP_DSO=""
  for dso in ${RTPP_DSOS}
  do
    dso_d="`echo ${dso} | sed 's|_debug||'`"
    RTPP_DSO="--dso ${TOP_BUILDDIR}/modules/${dso_d}/.libs/rtpp_${dso}.so ${RTPP_DSO}"
  done

  for rargs in "--config ${RTPP_CONF} -c fifo -L 100" \
   "-c rr -u ${myuid}:${mygid} ${RTPP_DSO}" ""
  do
    for sig in TERM HUP
    do
      # Keep the network listeners reserved by the parent shell, and both
      # Unix listener types private to this test invocation.
      RTPP_SOCKFILE="${STARTSTOP_TMPDIR}/default.sock"
      SOCK_RARGS="${STARTSTOP_CONTROL_ARGS}
        -s unix:${STARTSTOP_TMPDIR}/ctrl.sock
        -s cunix:${STARTSTOP_TMPDIR}/cctrl.sock"

      rm -f rtpproxy_acct.csv
      echo "rtpproxy_start ${rargs} ${SOCK_RARGS}" >&2
      rtpproxy_start ${rargs} ${SOCK_RARGS}
      report "${RTPPROXY}: start"
      rtpproxy_stop ${sig}
      report "${RTPPROXY}: stop (SIG${sig})"
      rm -f "${TMP_PIDFILE}" "${TMP_SOCKFILE}"
      TMP_PIDFILE=""
      cat "${TMP_LOGFILE}" >> "${TS_LOGFILE}"
      rm "${TMP_LOGFILE}"
      ${DIFF} "${BASEDIR}/startstop/${REF_OUTFILE}" "${RTPP_OUTFILE}"
      report "${RTPPROXY}: output"
    done
  done
  rm -rf "${STARTSTOP_TMPDIR}"
  STARTSTOP_TMPDIR=""
}
