#!/bin/sh

# Test will start rtpproxy, initiate a stream playing out,
# capture and decode packers them with extractaudio and verifies the
# checksums for all supported codecs.
#
# The commands are issued by playback1.rptl to a single rtpproxy instance,
# with all ports allocated dynamically and all playbacks running in
# parallel. The streams are captured by udp_capture.py, so no root
# privileges are required.

BASEDIR="`dirname "${0}"`/.."
. "${BASEDIR}/functions"

OUT="playback1"
TYPES="1 2 3 4 5 6 7"
CODECS="0 3 8 18 9"
PLAYBACK_RFILES="playback1.0 playback1.3 playback1.8 playback1.18 playback1.9"

# The tools may be run under a wrapper, e.g. setpriv when started as root.
# The RPTL interpreter is wrapped as well, so whatever it starts already
# runs with the right credentials: give it bare commands.
strip_wrapper() {
  echo "${1##* -- }"
}

# Expected TOS of the captured IPv4 packets, if checked
expected_tos() {
  case "${1}" in
  4|7)
    echo "0x2a"
    ;;
  5)
    echo "0xb8"
    ;;
  6)
    echo "0x2b"
    ;;
  esac
}

# Ports are allocated dynamically, replace them with a placeholder
normalize() {
  awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+$/ && $i >= 1024) $i = "PORT"; print }'
}

# Number of commands in the given stage of the given type
stage_ncmds() {
  if [ -e ${BASEDIR}/playback/playback1.type${1}.${2}.rptl ]
  then
    grep -c '^r:' ${BASEDIR}/playback/playback1.type${1}.${2}.rptl
  else
    echo 0
  fi
}

# The replies to the given range of commands of the given type, the
# commands of all stages go in a sequence in the reference output
model_replies() {
  if [ -e ${BASEDIR}/playback/playback1.type${1}.output ]
  then
    MODEL_ROUT=${BASEDIR}/playback/playback1.type${1}.output
  else
    MODEL_ROUT=${BASEDIR}/playback/playback1.output
  fi
  if [ ${3} -gt 0 ]
  then
    sed -n "$((${2} + 1)),$((${2} + ${3}))p" ${MODEL_ROUT}
  fi
}

RUNS=""
RUNS_ST2=""
for ttype in ${TYPES}
do
  for codec in ${CODECS}
  do
    if [ ${ttype} -eq 3 ]
    then
      npkts=100
    elif [ ${codec} -eq 3 ]
    then
      npkts=300
    else
      npkts=600
    fi
    RUNS="${RUNS} ${ttype}:${codec}:${npkts}"
    if [ `stage_ncmds ${ttype} st2` -gt 0 ]
    then
      RUNS_ST2="${RUNS_ST2} ${ttype}:${codec}:${npkts}"
    fi
  done
done

rm -f ${PLAYBACK_RFILES}
${MAKEANN} "${BASEDIR}/ringback.sln" playback1
report "makeann playback1"

${RPTL_INT} -s "${BASEDIR}/playback/playback1.rptl" \
 -D RTPPROXY_BIN="`strip_wrapper "${RTPPROXY}"`" -D RUNS="${RUNS}" \
 -D RUNS_ST2="${RUNS_ST2}" \
 -D PYINT="${PYINT}" -D CAPTURE="${PYTHON_DIR}/tools/udp_capture.py" \
 -D OUT="${OUT}" > ${OUT}.vars 2> ${OUT}.rptl.rlog
RPTL_RC=${?}
if [ ${RPTL_RC} -ne 0 ]
then
  cat ${OUT}.rptl.rlog >&2
fi
report_rc ${RPTL_RC} "running playback1.rptl"

# The stages are issued for all runs in turn: the first one, the second
# one for the types that have it, NAT and then the D commands
for stage in st1 st2 nat D
do
  for run in ${RUNS}
  do
    ttype="${run%%:*}"
    n1=`stage_ncmds ${ttype} st1`
    n2=`stage_ncmds ${ttype} st2`
    case ${stage} in
    st1)
      model_replies ${ttype} 0 ${n1}
      ;;
    st2)
      model_replies ${ttype} ${n1} ${n2}
      ;;
    nat)
      model_replies ${ttype} $((${n1} + ${n2})) 1
      ;;
    D)
      echo 0
      echo 0
      ;;
    esac
  done
done > ${OUT}.rout.model
normalize < ${OUT}.rout > ${OUT}.rout.norm
normalize < ${OUT}.rout.model | ${DIFF} - ${OUT}.rout.norm
report "checking rtpproxy stdout"

for ttype in ${TYPES}
do
  for codec in ${CODECS}
  do
    ofile="playback1.${codec}.wav"
    ${EXTRACTAUDIO} -n playback1.${ttype}.${codec} ${ofile} | grep -v 'delta '
    report "extractaudio playback1.${ttype}.${codec} -> ${ofile}"
    sha256_verify ${ofile} ${BASEDIR}/playback/playback1.checksums
    tos="`expected_tos ${ttype}`"
    if [ -n "${tos}" ]
    then
      RES="`cat playback1.${ttype}.${codec}.tos`"
      test "${RES}" = "${tos}"
      report "checking TOS [${RES}]"
    fi
  done
done
