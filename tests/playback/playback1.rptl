# Play all RUNS through an independent RTPProxy recorder. Recorder session
# ports are allocated on demand; asymmetric mode accepts source-port changes.
# Expects RTPPROXY_BIN, RECORDER_BIN, RUNS, RUNS_ST2, RECORD_DIR and OUT.

.eval: %%RTPPROXY_BIN%% -> PLAYER_BIN
.eval: %%RECORDER_BIN%% -> RTPPROXY_BIN
.eval: %%OUT%%.recorder.rlog -> RTPPROXY_STDERR
socket c: stdio: -l 0.0.0.0 -6 /:: -T60 -W60 -d info -P -r %%RECORD_DIR%% -> %%OUT%%.recorder.rout
.eval: %%PLAYER_BIN%% -> RTPPROXY_BIN
.eval: %%OUT%%.rlog -> RTPPROXY_STDERR
socket r: stdio: -l 0.0.0.0 -6 /:: -T10 -d info -> %%OUT%%.rout
.eval: 0 -> RES_OK

.foreach: RUN in %%RUNS%% do playback1.setup.rptl
.eval: st1 -> STAGE
.foreach: RUN in %%RUNS%% do playback1.stage.rptl
.sleep: 1
.eval: st2 -> STAGE
.foreach: RUN in %%RUNS_ST2%% do playback1.stage.rptl
.sleep: 1
.foreach: RUN in %%RUNS%% do playback1.nat.rptl
.foreach: RUN in %%RUNS%% do playback1.teardown.rptl

.close: r
.close: c
