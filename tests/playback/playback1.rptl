# Plays the prompt out of a single rtpproxy instance towards capturing
# sockets, for all of the RUNS (list of TYPE:CODEC:NPKTS) at once. Each
# stage of the playback is issued for all runs in turn, followed by the
# next stage and so on. The ports are allocated dynamically, the replies
# are logged into OUT.rout and the IPv4 packets received for each run are
# saved into OUT.TYPE.CODEC.a.rtp, together with their TOS in
# OUT.TYPE.CODEC.tos, to be examined by playback1.
#
# Expects RTPPROXY_BIN, RUNS, RUNS_ST2 (the RUNS that have the second
# stage), PYINT, CAPTURE and OUT to be defined.

.eval: %%OUT%%.rlog -> RTPPROXY_STDERR
socket r: stdio: -l 0.0.0.0 -6 /:: -T10 -b -d info -> %%OUT%%.rout

.foreach: RUN in %%RUNS%% do playback1.setup.rptl
.eval: st1 -> STAGE
.foreach: RUN in %%RUNS%% do playback1.stage.rptl
.sleep: 1
.eval: st2 -> STAGE
.foreach: RUN in %%RUNS_ST2%% do playback1.stage.rptl
.sleep: 1
.foreach: RUN in %%RUNS%% do playback1.nat.rptl
.foreach: RUN in %%RUNS%% do playback1.teardown.rptl

.close: r
