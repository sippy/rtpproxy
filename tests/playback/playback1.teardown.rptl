# Wait for both expected packet counts or both recorder sessions to expire.
.include: playback1.restore.rptl
.eval: npkts_ina=%%NPKTS%% npkts_ina=%%NPKTS%% -> EXPECTED_PACKETS
.until: RECORDING_DONE do playback1.check.rptl every 0.1 30
r: D %%CID%% from_tag_1
r: D %%CID%%_ipv6 from_tag_1
# Stop the player first, then close recordings that have not already expired.
c: D %%OUT%%.%%T%%.%%CODEC%% from_tag_1
c: D %%OUT%%.%%T%%.%%CODEC%%_ipv6 from_tag_1
