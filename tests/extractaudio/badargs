#!/bin/sh

BASEDIR="`dirname "${0}"`/.."
. "${BASEDIR}/functions"

for bad_args in "-F foo" "-D bar" "--alice-crypto" "--alice-crypto=invalid" \
 "--alice-crypto=invalid:bar" "--alice-crypto=AES_CM_128_HMAC_SHA1_80:garbage" \
 "--bob-crypto=AES_CM_128_HMAC_SHA1_80:UBFc5R7tK5f91V8j1da++z3h/3H2yS5WaN819nJ-" \
 "-S /dev/null /dev/null" "-A /dev/null -B /dev/null /dev/null" \
 "-S -A /dev/null -B /dev/null /dev/null"
do
  ${EXTRACTAUDIO} ${bad_args}
  reportifnotfail "extractaudio start with bad argumens: ${bad_args}"
done

# Output options are checked with a valid recording, so that nothing but the
# bad value can make extractaudio fail, and before the output file is created.
wfile="badargs.out.ogg"
for bad_args in "-r 11025" "-r 16000x" "-r ''" "-r 16000 -D gsm610" \
 "-r 16000 -D g721_32" "-b 64" "-b 5 -D opus" "-b 300 -D opus" \
 "-s -b 6 -D opus" "-s -b 600 -D opus" "-b nan -D opus" "-b -nan -D opus" \
 "-b ''" "-b 64 -C 0.5 -D opus" "-C 2" "-C -0.5" "-C nan" "-C -nan" \
 "-C NaN -D opus" "-C ''"
do
  rm -f ${wfile}
  eval ${EXTRACTAUDIO} -F ogg ${bad_args} extractaudio/call1_alaw ${wfile} \
   >/dev/null 2>&1
  reportifnotfail "extractaudio start with bad argumens: ${bad_args}"
  test ! -e ${wfile}
  report "${wfile} is not created for: ${bad_args}"
done

# Data formats without a compression level are only detected once the output
# file is open, which has to be removed then.
wfile="badargs.clevel.wav"
${EXTRACTAUDIO} -D pcm_16 -C 0.5 extractaudio/call1_alaw ${wfile}
reportifnotfail "extractaudio start with bad argumens: -D pcm_16 -C 0.5"
test ! -e ${wfile}
report "${wfile} is removed"

# A PCAP record whose incl_len runs past the end of the file has to be
# rejected, not read.
rbase="badargs.trunc"
dd if=extractaudio/call1_g722_srtp.a.rtp of=${rbase}.a.rtp bs=264 count=1 \
 2>/dev/null
# incl_len = 0x10000000, RTP P bit set so that the parser reads the last byte
printf '\000\000\000\020' | dd of=${rbase}.a.rtp bs=1 seek=32 conv=notrunc \
 2>/dev/null
printf '\240' | dd of=${rbase}.a.rtp bs=1 seek=82 conv=notrunc 2>/dev/null
cp ${rbase}.a.rtp ${rbase}.o.rtp
${EXTRACTAUDIO} ${rbase} ${rbase}.wav >/dev/null 2>&1
test ${?} -eq 1
report "extractaudio rejects a truncated PCAP record"
rm -f ${rbase}.a.rtp ${rbase}.o.rtp ${rbase}.wav
